{
  "name": "plugin-permissions",
  "version": "1.0.0",
  "private": true,
  "description": "OpenGhost's Pi permission plugin: the sole permission policy and enforcement layer.",
  "type": "module",
  "license": "MIT",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "bundle": "node scripts/bundle.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "gen:schema": "node scripts/generate-schema.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "tree-sitter-bash": "0.25.1",
    "web-tree-sitter": "0.26.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/node": "22.15.3",
    "esbuild": "0.25.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
