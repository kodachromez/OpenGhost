#!/usr/bin/env python3
# A scripted stand-in for `pi --mode rpc` (test only): the RPC records PiBackend
# relies on, shaped as Pi 1.0.4 emits them. No model, network or credentials.
# The prompt text picks the run: reject, handled, fail, length, tools, slow,
# delay, switch (an extension changes the model); anything else is echoed. While "slow" runs, steers queue; a steer
# containing "now" delivers the queue in order. FAKE_PI_LOG records commands
# (with their prompt images) and, per run, the standing instructions and pinned
# files its system prompt carried. Model "v" sees images; "m" and "m2" do not.
# With --session <file>, entries persist there as Pi's do: the file appears with
# the first user or assistant message, then grows one JSON line per entry.
import json, os, select, sys, time

bridge = sys.argv[sys.argv.index("-e") + 1] if "-e" in sys.argv else ""
session = sys.argv[sys.argv.index("--session") + 1] if "--session" in sys.argv else ""
log = open(os.environ["FAKE_PI_LOG"], "a") if os.environ.get("FAKE_PI_LOG") else None
streaming = False
queue = []
last_stop = None
timers = []  # (due, callback)
entries = []
flushed = False
model = None  # (provider, id) Pi has selected
instructions = ""
files = []  # the bridge's pinned files: [{name, text}]
INPUTS = {"m": ["text"], "m2": ["text"], "v": ["text", "image"]}
if session and os.path.exists(session):
    with open(session) as saved:
        entries = [json.loads(line) for line in saved if line.strip()][1:]
    flushed = True
    for entry in entries:
        if entry.get("type") == "message" and entry["message"].get("role") == "assistant":
            last_stop = entry["message"].get("stopReason")
        if entry.get("type") == "model_change":
            model = (entry["provider"], entry["modelId"])


def selected():
    return model or ("p", "m")


def append(entry):
    global flushed
    entry = dict(entry, id="e%d" % (len(entries) + 1))
    entries.append(entry)
    if not session:
        return
    conversation = any(e.get("type") == "message" and e["message"].get("role") in ("user", "assistant")
                       for e in entries)
    if not flushed and conversation:
        with open(session, "w") as out_file:
            out_file.write(json.dumps({"type": "session", "id": "s", "cwd": os.getcwd()}) + "\n")
            for e in entries:
                out_file.write(json.dumps(e) + "\n")
        flushed = True
    elif flushed:
        with open(session, "a") as out_file:
            out_file.write(json.dumps(entry) + "\n")


def note(record):
    if log:
        log.write(json.dumps(dict(record, session=os.path.basename(session))) + "\n")
        log.flush()


def out(record):
    sys.stdout.write(json.dumps(record) + "\n")
    sys.stdout.flush()


def respond(cid, command, ok=True, data=None, error=None):
    record = {"id": cid, "type": "response", "command": command, "success": ok}
    if data is not None:
        record["data"] = data
    if error is not None:
        record["error"] = error
    out(record)


def usage(inp, outp, read=0, write=0):
    return {"input": inp, "output": outp, "cacheRead": read, "cacheWrite": write,
            "totalTokens": inp + outp + read + write,
            "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}


def assistant(text, stop="stop", spent=None, error=None):
    global last_stop
    message = {"role": "assistant", "content": [{"type": "text", "text": text}] if text else [],
               "api": "fake", "provider": selected()[0], "model": selected()[1],
               "usage": spent or usage(0, 0), "stopReason": stop, "timestamp": 0}
    if error:
        message["errorMessage"] = error
    out({"type": "message_start", "message": dict(message, content=[], stopReason="pending")})
    if text:
        out({"type": "message_update", "usage": message["usage"],
             "assistantMessageEvent": {"type": "text_delta", "contentIndex": 0, "delta": text}})
    out({"type": "message_end", "message": message})
    append({"type": "message", "message": message})
    last_stop = stop


def user(text, images=None):
    message = {"role": "user", "content": [{"type": "text", "text": text}] + list(images or []), "timestamp": 0}
    out({"type": "message_start", "message": message})
    out({"type": "message_end", "message": message})
    append({"type": "message", "message": message})


def settle():
    global streaming
    out({"type": "agent_end", "messages": [], "willRetry": False})
    out({"type": "agent_settled"})
    streaming = False


def status(token, value):
    out({"type": "extension_ui_request", "id": "ui-" + token, "method": "setStatus",
         "statusKey": "openghost:" + token, "statusText": json.dumps(value)})


def run(text, images=None):
    global streaming
    streaming = True
    note({"type": "run", "instructions": instructions, "files": files})  # before_agent_start's sections
    out({"type": "agent_start"})
    user(text, images)
    if text == "fail":
        assistant("partial", "error", usage(10, 2), "boom 500")
    elif text == "length":
        assistant("cut", "length", usage(5, 7))
    elif text == "tools":
        assistant("Let me check.", "toolUse", usage(40, 4))
        assistant("Done.", "stop", usage(60, 6, 40))
    elif text == "switch":  # An extension changes Pi's model (pi.setModel) mid-run.
        globals()["model"] = ("p", "m2")
        append({"type": "model_change", "provider": "p", "modelId": "m2"})
        assistant("Switched.", "stop", usage(8, 2))
    elif text in ("slow", "delay"):
        out({"type": "message_start", "message": {"role": "assistant", "content": [],
             "provider": selected()[0], "model": selected()[1], "stopReason": "pending", "usage": usage(0, 0)}})
        out({"type": "message_update", "usage": usage(50, 1),
             "assistantMessageEvent": {"type": "text_delta", "contentIndex": 0, "delta": "working"}})
        return  # Still streaming: steer, or abort.
    else:
        assistant("Echo: " + text, "stop", usage(100, 20, 30, 5))
    settle()


def bridged(cid, request):
    token = request.get("token", "")
    op = request.get("op")
    if op == "providers":
        status(token, {"ok": True, "providers": []})
    elif op == "retry":
        if streaming:
            status(token, {"ok": False, "error": "Pi is still busy."})
        elif last_stop != "error":
            status(token, {"ok": False, "error": "Pi's latest reply did not fail, so there is nothing to retry."})
        else:
            status(token, {"ok": True})
            respond(cid, "prompt", data={"disposition": "handled"})
            # A continuation: the hidden trigger, no user message, then the reply.
            globals()["streaming"] = True
            note({"type": "run", "instructions": instructions, "files": files})  # the base prompt's sections
            out({"type": "agent_start"})
            trigger = {"role": "custom", "customType": "openghost-retry", "content": [], "display": False}
            out({"type": "message_start", "message": trigger})
            out({"type": "message_end", "message": trigger})
            append({"type": "custom_message", "customType": "openghost-retry", "content": [], "display": False})
            assistant("Recovered.", "stop", usage(12, 3))
            settle()
            return
    elif op == "context":
        globals()["instructions"] = request.get("instructions", "")
        globals()["files"] = request.get("files", [])
        status(token, {"ok": True})
    elif op == "mark":
        append({"type": "custom", "customType": "openghost-turn", "data": request.get("entry")})
        status(token, {"ok": True})
    else:
        status(token, {"ok": True})
    respond(cid, "prompt", data={"disposition": "handled"})


def handle(command):
    global streaming, queue
    kind, cid = command.get("type"), command.get("id")
    record = {k: command[k] for k in ("type", "message", "provider", "modelId") if k in command}
    if "images" in command:
        record["images"] = [{"mimeType": i.get("mimeType"), "bytes": len(i.get("data", ""))} for i in command["images"]]
    note(record)
    if kind == "get_commands":
        respond(cid, kind, data={"commands": [{"name": "openghost", "source": "extension",
                                               "sourceInfo": {"path": bridge}}]})
    elif kind == "get_available_models":
        respond(cid, kind, data={"models": [{"id": m, "provider": "p", "name": m.upper(), "input": i}
                                            for m, i in INPUTS.items()]})
    elif kind == "set_model":
        if command.get("modelId") == "gone":
            return respond(cid, kind, False, error="Model not found: %s/gone" % command.get("provider"))
        globals()["model"] = (command["provider"], command["modelId"])
        append({"type": "model_change", "provider": command["provider"], "modelId": command["modelId"]})
        respond(cid, kind, data={"id": command["modelId"], "provider": command["provider"], "name": "M"})
    elif kind == "get_state":
        data = {"isStreaming": streaming, "sessionFile": session}
        if model:
            data["model"] = {"provider": model[0], "id": model[1], "name": model[1].upper(),
                             "input": INPUTS.get(model[1], ["text"])}
        elif not session:  # The control child: Pi's own default.
            data["model"] = {"provider": "p", "id": "m2", "name": "M2", "input": ["text"]}
        respond(cid, kind, data=data)
    elif kind == "get_entries":
        respond(cid, kind, data={"entries": entries, "leafId": entries[-1]["id"] if entries else None})
    elif kind == "prompt":
        text = command.get("message", "")
        if text.startswith("/openghost "):
            return bridged(cid, json.loads(text[len("/openghost "):]))
        if streaming:
            return respond(cid, kind, False, error="Agent is already processing.")
        if text == "reject":
            return respond(cid, kind, False, error="No API key found for p.")
        if text == "handled":
            return respond(cid, kind, data={"disposition": "handled"})
        if text == "delay":  # Accepted only after a pause.
            due = time.time() + 0.3
            timers.append((due, lambda: (respond(cid, kind, data={"disposition": "started"}), run(text))))
            return
        respond(cid, kind, data={"disposition": "started"})
        run(text, command.get("images"))
    elif kind == "steer":
        text = command.get("message", "")
        if text == "drop":
            return respond(cid, kind, data={"disposition": "handled"})
        if text.startswith("/t "):  # An input handler's transformation.
            text = "expanded: " + text[3:]
        queue.append(text)
        out({"type": "queue_update", "steering": list(queue), "followUp": []})
        respond(cid, kind, data={"disposition": "queued"})
        if "now" in text:
            out({"type": "message_end", "message": {"role": "assistant", "content": [{"type": "text", "text": "working"}],
                 "provider": selected()[0], "model": selected()[1], "stopReason": "stop", "usage": usage(50, 1)}})
            while queue:
                item = queue.pop(0)
                out({"type": "queue_update", "steering": list(queue), "followUp": []})
                user(item)
            assistant("Steered.", "stop", usage(70, 5))
            settle()
    elif kind == "clear_queue":
        cleared, queue = queue, []
        out({"type": "queue_update", "steering": [], "followUp": []})
        respond(cid, kind, data={"steering": cleared, "followUp": []})
    elif kind == "abort":
        if streaming:
            out({"type": "message_end", "message": {"role": "assistant", "content": [{"type": "text", "text": "working"}],
                 "provider": selected()[0], "model": selected()[1], "stopReason": "aborted", "usage": usage(50, 3)}})
            globals()["last_stop"] = "aborted"
            settle()
        respond(cid, kind)
    else:
        respond(cid, kind, False, error="Unknown command: %s" % kind)


buffer = b""
while True:
    wait = None
    if timers:
        wait = max(0.0, min(due for due, _ in timers) - time.time())
    ready, _, _ = select.select([sys.stdin.buffer], [], [], wait)
    for due, callback in [t for t in timers if t[0] <= time.time()]:
        timers.remove((due, callback))
        callback()
    if not ready:
        continue
    chunk = os.read(sys.stdin.fileno(), 65536)
    if not chunk:
        break
    buffer += chunk
    while b"\n" in buffer:
        line, buffer = buffer.split(b"\n", 1)
        if line.strip():
            handle(json.loads(line))
